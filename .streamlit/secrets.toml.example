# Streamlit Community Cloud: paste this entire block into
# Manage app → Settings → Secrets
#
# Local dev: copy to .streamlit/secrets.toml (never commit secrets.toml)

[supabase]
url = "https://YOUR-PROJECT-ID.supabase.co"
key = "YOUR_SUPABASE_ANON_OR_SERVICE_KEY"

[app]
# Must match the exact URL in your browser on Streamlit Cloud, e.g.:
# https://hampton-ptac-tracker.streamlit.app
base_url = "https://YOUR-APP-NAME.streamlit.app"
